   "source": [
    "# ── Cell 6: Side-by-side comparison table ─────────────────────────────────────\n",
    "import pandas as pd\n",
    "\n",
    "# Ground truth tool set for the INV-78432 scenario\n",
    "GT_TOOLS = {\"FlowLogTool\", \"RoutingDecisionTool\", \"OrgConfigTool\"}\n",
    "\n",
    "# ── Approach A metrics ────────────────────────────────────────────────────────\n",
    "all_activated_A = set()\n",
    "for r in results_A:\n",
    "    all_activated_A.update(r.activated_tools)\n",
    "\n",
    "precision_A = len(all_activated_A & GT_TOOLS) / len(all_activated_A) if all_activated_A else 0\n",
    "recall_A    = len(all_activated_A & GT_TOOLS) / len(GT_TOOLS)\n",
    "f1_A        = (2 * precision_A * recall_A / (precision_A + recall_A)\n",
    "               if (precision_A + recall_A) > 0 else 0)\n",
    "\n",
    "total_latency_A = sum(r.latency_ms for r in results_A)\n",
    "rounds_A        = len(results_A)\n",
    "tool_calls_A    = total_tool_calls_A\n",
    "\n",
    "# ── Approach B metrics ────────────────────────────────────────────────────────\n",
    "all_activated_B = set(tracker_B.tool_calls)\n",
    "\n",
    "precision_B = len(all_activated_B & GT_TOOLS) / len(all_activated_B) if all_activated_B else 0\n",
    "recall_B    = len(all_activated_B & GT_TOOLS) / len(GT_TOOLS)\n",
    "f1_B        = (2 * precision_B * recall_B / (precision_B + recall_B)\n",
    "               if (precision_B + recall_B) > 0 else 0)\n",
    "\n",
    "rounds_B     = len(result_B.get(\"intermediate_steps\", []))\n",
    "tool_calls_B = len(tracker_B.tool_calls)\n",
    "\n",
    "# ── Table ─────────────────────────────────────────────────────────────────────\n",
    "df = pd.DataFrame([\n",
    "    {\n",
    "        \"Approach\":             \"A — Semantic Matching (DyTopo)\",\n",
    "        \"Tool selection\\":      \"cosine(Q,K) > τ\",\n",
    "        \"LLM calls\":            total_llm_calls_A,\n",
    "        \"Tool calls (total)\":   tool_calls_A,\n",
    "        \"Rounds\":               rounds_A,\n",
    "        \"Precision\":            round(precision_A, 2),\n",
    "        \"Recall\":               round(recall_A, 2),\n",
    "        \"F1\":                   round(f1_A, 2),\n",
    "        \"Latency (ms)\\":        round(total_latency_A, 1),\n",
    "        \"Score logged\":         \"Yes — cosine per tool\",\n",
    "    },\n",
    "    {\n",
    "        \"Approach\":             \"B — LangChain ReAct\",\n",
    "        \"Tool selection\":       \"LLM reasons from docstrings\",\n",
    "        \"LLM calls\":            tracker_B.llm_calls,\n",
    "        \"Tool calls (total)\":   tool_calls_B,\n",
